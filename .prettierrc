{
  "plugins": ["prettier-plugin-svelte", "prettier-plugin-css-order"],
  "cssDeclarationSorterOrder": "smacss",
  "cssDeclarationSorterKeepOverrides": true,
  "printWidth": 140,
  "overrides": [
    { "files": "scripts/catalog/data/tags.json", "options": { "printWidth": 1000 } },
    { "files": "static/kdm/catalog/data.json", "options": { "printWidth": 280, "objectWrap": "collapse" } },
    { "files": "static/kdm/catalog/data.schema.json", "options": { "objectWrap": "collapse" } }
  ]
}
