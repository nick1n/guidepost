{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KDM workbook to catalog edition mapping",
  "description": "Product references for one workbook snapshot. Sheet and row locate a source record; they are not permanent IDs. A future importer must verify the row name and structure before applying values, and keep multiple release alternatives ambiguous until resolved.",
  "type": "object",
  "required": ["$schema", "formatVersion", "source", "rows"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "./workbook-map.schema.json" },
    "formatVersion": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["id", "workbook"],
      "additionalProperties": false,
      "properties": { "id": { "const": "kdm-collection-sheets" }, "workbook": { "type": "string", "minLength": 1 } }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sheet", "row", "name", "primary"],
        "additionalProperties": false,
        "properties": {
          "sheet": { "enum": ["KDM Miniatures", "Shirt Catalog", "Dice Catalog"] },
          "row": { "type": "integer", "minimum": 2 },
          "name": { "type": "string", "minLength": 1 },
          "primary": { "$ref": "#/$defs/target" },
          "related": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/target" } },
          "ownershipScope": { "const": "source-row" },
          "releaseEditions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "M": { "$ref": "#/$defs/alternatives" },
              "N": { "$ref": "#/$defs/alternatives" },
              "O": { "$ref": "#/$defs/alternatives" }
            }
          }
        },
        "allOf": [
          { "if": { "required": ["related"] }, "then": { "required": ["ownershipScope"] } },
          {
            "if": { "properties": { "sheet": { "enum": ["Shirt Catalog", "Dice Catalog"] } }, "required": ["sheet"] },
            "then": { "properties": { "primary": { "properties": { "editionId": { "const": "item" } } } } }
          }
        ]
      }
    }
  },
  "$defs": {
    "alternatives": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/target" } },
    "target": {
      "type": "object",
      "required": ["category", "contentId", "editionId"],
      "additionalProperties": false,
      "properties": {
        "category": { "enum": ["content", "accessories", "bundles", "included-only"] },
        "contentId": { "type": "string", "minLength": 1 },
        "editionId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Permanent edition ID scoped to contentId, or the synthetic item/bundle ID."
        },
        "sourceEdition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
