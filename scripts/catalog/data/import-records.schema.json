{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KDM workbook import records",
  "type": "object",
  "required": ["$schema", "workbook", "sheets", "records"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "workbook": { "type": "string" },
    "sheets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "headers", "rows", "auxiliaryCells"],
        "additionalProperties": false,
        "properties": {
          "name": { "enum": ["KDM Miniatures", "Shirt Catalog", "Dice Catalog"] },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "rows": { "type": "integer", "minimum": 1 },
          "auxiliaryCells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["cell", "value"],
              "additionalProperties": false,
              "properties": { "cell": { "type": "string" }, "value": { "type": ["string", "number", "boolean", "null"] } }
            }
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sheet", "row", "name", "itemId", "category", "cells", "productCells", "comments", "editionId"],
        "additionalProperties": false,
        "properties": {
          "sheet": { "enum": ["KDM Miniatures", "Shirt Catalog", "Dice Catalog"] },
          "row": { "type": "integer", "minimum": 2 },
          "name": { "type": "string" },
          "itemId": { "type": "string" },
          "category": { "enum": ["content", "accessories", "bundles", "included-only"] },
          "cells": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Z]+$" },
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] },
            "description": "Personal values, including unchecked false states. Missing cells were blank."
          },
          "productCells": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Z]+$" },
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] },
            "description": "Original product cells for lossless reconstruction. Excel dates remain original serial numbers; normalized dates live in the catalog."
          },
          "comments": { "type": "object", "additionalProperties": { "type": "string" } },
          "relatedItems": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "Other releases described by the same workbook row, including another edition of the same item. Personal ownership values are not automatically assigned to each release.",
            "items": {
              "type": "object",
              "required": ["category", "itemId", "editionId"],
              "additionalProperties": false,
              "properties": {
                "category": { "enum": ["content", "accessories", "bundles", "included-only"] },
                "itemId": { "type": "string" },
                "editionId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "description": "Permanent catalog edition ID; item or bundle for products without explicit editions."
                }
              }
            }
          },
          "ownershipScope": {
            "const": "source-row",
            "description": "General personal cells describe the source row, which spans multiple catalog releases. Use releaseEditions for individual run checkboxes; multiple alternatives still require a material choice before assigning ownership."
          },
          "releaseEditions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "description": "Catalog choices represented by each present workbook release checkbox: M First Run, N Encore, O General. A named material release can carry a short label such as Deathgrey or Plastic. Arrays contain alternatives when a checkbox spans multiple materials. Preserve the raw value as ownership; applicability comes from presence. Explicit source-note corrections are recorded in the merge report.",
            "properties": {
              "M": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": ["category", "itemId", "editionId"],
                  "additionalProperties": false,
                  "properties": {
                    "category": { "enum": ["content", "accessories", "bundles", "included-only"] },
                    "itemId": { "type": "string" },
                    "editionId": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "Permanent catalog edition ID; item or bundle for products without explicit editions."
                    }
                  }
                }
              },
              "N": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": ["category", "itemId", "editionId"],
                  "additionalProperties": false,
                  "properties": {
                    "category": { "enum": ["content", "accessories", "bundles", "included-only"] },
                    "itemId": { "type": "string" },
                    "editionId": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "Permanent catalog edition ID; item or bundle for products without explicit editions."
                    }
                  }
                }
              },
              "O": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": ["category", "itemId", "editionId"],
                  "additionalProperties": false,
                  "properties": {
                    "category": { "enum": ["content", "accessories", "bundles", "included-only"] },
                    "itemId": { "type": "string" },
                    "editionId": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "Permanent catalog edition ID; item or bundle for products without explicit editions."
                    }
                  }
                }
              }
            }
          },
          "editionId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Permanent catalog edition ID; item or bundle for products without explicit editions."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "sheet": { "enum": ["Shirt Catalog", "Dice Catalog"] } }, "required": ["sheet"] },
            "then": { "properties": { "editionId": { "const": "item" } } }
          },
          { "if": { "required": ["relatedItems"] }, "then": { "required": ["ownershipScope"] } },
          { "if": { "required": ["releaseEditions"] }, "then": { "properties": { "sheet": { "const": "KDM Miniatures" } } } }
        ]
      }
    }
  }
}
