{
  "name": "Guidepost",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "generate:types": "node scripts/generate-types.mts",
    "check:shop-links": "node scripts/check-shop-links.mts",
    "scrape:news": "node scripts/scrape-news-shop-links.mts",
    "catalog:update": "node scripts/update-catalog.mts",
    "catalog:availability": "node scripts/refresh-catalog-availability.mts",
    "catalog:editions": "node scripts/fill-catalog-editions.mts",
    "catalog:validate": "node scripts/catalog/validate.mts",
    "catalog:tags": "node scripts/update-catalog.mts --tags-only",
    "catalog:tags-schema": "node scripts/update-catalog.mts --tags-schema",
    "test:catalog": "node --test test/scrape-news-checks.mts test/catalog-checks.mts test/edition-retrieval-checks.mts",
    "dev": "pnpm generate:types && vite dev",
    "build": "pnpm generate:types && vite build",
    "preview": "vite preview",
    "check": "pnpm generate:types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project src/service-worker/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.136",
    "@iconify-json/material-symbols": "^1.2.90",
    "@sveltejs/adapter-static": "4.0.0-next.4",
    "@sveltejs/kit": "next",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unocss/svelte-scoped": "66.9.1",
    "ajv": "8.17.1",
    "htmlparser2": "^12.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "unocss": "^66.9.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@unocss/reset": "^66.9.1",
    "effect": "4.0.0-rc.115"
  }
}
