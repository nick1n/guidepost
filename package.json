{
  "name": "Guidepost",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:client": "vitest run --project client",
    "test:collection-browser": "node test/client/collection-browser.mts",
    "test:menu-browser": "node test/client/menu-browser.mts",
    "test:hunt-browser": "node test/client/hunt-browser.mts",
    "test:hunt-artwork-browser": "node test/client/hunt-artwork-browser.mts",
    "test:hunt-navigation-browser": "node test/client/hunt-navigation-browser.mts",
    "test:hunt-picker-browser": "node test/client/hunt-picker-browser.mts",
    "test:scripts": "vitest run --project scripts && node --test \"test/scripts/**/*-checks.mts\"",
    "generate:types": "node scripts/generate-types.mts",
    "check:shop-links": "node scripts/catalog/commands/check-shop-links.mts",
    "scrape:news": "node scripts/news/scrape-shop-links.mts",
    "catalog:update": "node scripts/catalog/commands/update-catalog.mts",
    "catalog:availability": "node scripts/catalog/commands/refresh-catalog-availability.mts",
    "catalog:editions": "node scripts/catalog/commands/fill-catalog-editions.mts",
    "catalog:validate": "node scripts/catalog/commands/validate.mts",
    "catalog:workbook": "node scripts/catalog/commands/workbook.mts",
    "catalog:tags": "node scripts/catalog/commands/update-catalog.mts --tags-only",
    "catalog:tags-schema": "node scripts/catalog/commands/update-catalog.mts --tags-schema",
    "test:catalog": "pnpm test:scripts",
    "dev": "pnpm generate:types && vite dev",
    "build": "pnpm generate:types && vite build",
    "preview": "vite preview",
    "check": "pnpm generate:types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project src/service-worker/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@unocss/reset": "^66.11.0",
    "dexie": "^4.4.6",
    "effect": "^4.0.5"
  },
  "devDependencies": {
    "@effect/platform-node": "^4.0.5",
    "@effect/vitest": "^4.0.5",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/material-symbols": "^1.2.95",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unocss/svelte-scoped": "^66.11.0",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.6",
    "htmlparser2": "^12.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#catalog/*": "./static/kdm/catalog/*",
    "#lib/*": "./src/lib/*",
    "#scripts/*": "./scripts/*"
  }
}
